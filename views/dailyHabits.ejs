<!doctype html>
<html lang="en">

<head>
  <meta charset="UTF-8" />

  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title><%= title %></title>

  <link rel="stylesheet" href="../stylesheet/dailyHabits.css" />
  <link rel="icon" type="image/png" href="../images/Lumi Capybara Study Planner.png" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />

  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <link href="https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,200..1000;1,200..1000&family=Quicksand:wght@300..700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css" />
  <script src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
</head>

<body>
  <div class="main">
    <aside class="sidebar">
      <a href="/dashboard" class="brand">
        <span>Lumi</span>
      </a>

      <p class="navLabel">WORKSPACE</p>

      <nav class="navigation">
        <a href="/dashboard" class="navLink"> <span>🏡</span> Dashboard </a>
        <a href="/task" class="navLink"> <span>🌱</span> My Tasks </a>
        <a href="/calendar" class="navLink"> <span>📅</span> Calendar </a>
        <a href="/notes" class="navLink"> <span>📝</span> Notes </a>
        <a href="/lessons" class="navLink"> <span>📚</span> Lessons </a>
        <a href="/dailyHabits" class="navLink active">
          <span>🌷</span> Daily Habits
        </a>
        <a href="/focusSession" class="navLink">
          <span>⏳</span> Focus Session
        </a>
        <a href="/account" class="navLink">
          <span>⚙️</span> Account
        </a>
      </nav>

      <div class="sidebarBottom">
        <button id="logoutBtn" class="logoutButton" type="button">
          Log out
        </button>
      </div>
    </aside>

    <main class="habitSection">
      <div class="habitHeaderArea">
        <div>
          <h1>Sprout Habits</h1>

          <p class="headerSubtitle">Small habits grow into big changes 🌱</p>
        </div>

        <div class="dateDisplay">
          <span id="currentMonthYear"></span>
        </div>
      </div>

      <div class="habitCard">
        <div class="tableWrapper">
          <table class="habitTable">
            <thead>
              <tr id="habitDaysHeader">
                <th class="habitNameCol">
                  <div class="habitColHeader">
                    <span>Habits</span>

                    <button class="addHabitBtn" id="addHabitBtn" title="Add new habit">
                      + Add
                    </button>
                  </div>
                </th>
              </tr>
            </thead>

            <tbody id="habitTableBody"></tbody>
          </table>
        </div>
      </div>
    </main>

    <aside class="rightPanel">
      <div class="statCard streakCard">
        <div class="streakTop">
          <div class="streakFire">🔥</div>

          <div>
            <h3>Active Streak</h3>

            <p class="streakNumber habitStatSkeleton skeletonStreak" id="streakValue"></p>

            <span> days in a row </span>
          </div>
        </div>

        <div class="streakBottom">
          <span> 🏆 Best streak </span>

          <strong id="bestStreak" class="habitStatSkeleton skeletonBestStreak"></strong>
        </div>
      </div>

      <div class="statCard todayCard">
        <div class="cardHeading">
          <h3>Today's Progress</h3>

          <span> 🌱 </span>
        </div>

        <div class="todayProgress">
          <div class="progressCircle habitStatSkeleton skeletonProgressCircle" id="todayProgressCircle">
            <span class="progressPercent habitStatSkeleton skeletonProgressNumber" id="todayProgressPercent"></span>
          </div>

          <div class="todayInfo">
            <strong id="todayCompleted" class="habitStatSkeleton skeletonProgressNumber"></strong>

            <span> habits completed </span>
          </div>
        </div>

        <div class="progressBar">
          <div class="progressBarFill habitStatSkeleton skeletonProgressBar" id="todayProgressBar"></div>
        </div>
      </div>

      <div class="statCard monthlyCard">
        <div class="cardHeading">
          <h3>This Month</h3>

          <span> 📊 </span>
        </div>

        <div class="monthlyStats">
          <div class="monthlyStat">
            <strong id="monthlyCompletion" class="habitStatSkeleton skeletonMonthlyNumber"></strong>

            <span> Completion </span>
          </div>

          <div class="monthlyDivider"></div>

          <div class="monthlyStat">
            <strong id="monthlyCheckins" class="habitStatSkeleton skeletonMonthlyNumber"></strong>

            <span> Check-ins </span>
          </div>
        </div>

        <div class="monthlyMessage" id="monthlyMessage">
          🌱 Start growing your habits!
        </div>
      </div>
    </aside>
  </div>

  <div class="deleteModalOverlay" id="deleteHabitModal" hidden>
    <div class="deleteModalCard" role="dialog" aria-modal="true" aria-labelledby="deleteHabitModalTitle">
      <div class="deleteModalIcon">🌸</div>

      <h2 id="deleteHabitModalTitle">Delete this habit?</h2>

      <p id="deleteHabitModalMessage">
        Are you sure you want to delete this habit?
      </p>

      <div class="deleteModalButtons">
        <button type="button" id="cancelDeleteHabit">Cancel</button>
        <button type="button" id="confirmDeleteHabit">Yes, Delete</button>
      </div>
    </div>
  </div>

  <div class="addHabitModalOverlay" id="addHabitModal" hidden>
    <div class="addHabitModalCard" role="dialog" aria-modal="true" aria-labelledby="addHabitModalTitle">
      <div class="addHabitModalIcon">🌱</div>

      <h2 id="addHabitModalTitle">Grow a new habit!</h2>

      <p>What little habit would you like to grow?</p>

      <input type="text" id="newHabitName" placeholder="e.g. Read for 20 minutes" maxlength="50" autocomplete="off" />

      <div class="addHabitModalButtons">
        <button type="button" id="cancelAddHabit">Cancel</button>
        <button type="button" id="confirmAddHabit">Add Habit</button>
      </div>
    </div>
  </div>


  <script id="habits-data" type="application/json">
    <%- JSON.stringify(
    habits.map(habit => ({
      id: habit._id.toString(),
      name: habit.name,
      createdAt: habit.createdAt
    }))
  ).replace(/</g, "\\u003c") %>
  </script>

  <script id="checkins-data" type="application/json">
    <%- JSON.stringify(
        checkIns.map(checkIn => ({
          habitId: checkIn.habit.toString(),
          date: checkIn.date.toISOString().slice(0, 10)
        }))
      ) %>
  </script>

  <script src="/js/habits.js" defer></script>
</body>

</html>