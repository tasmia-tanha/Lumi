<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Lessons & Materials</title>
  <link rel="stylesheet" href="/stylesheet/lessons.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>

<body>
  <div class="appLayout">

    <aside class="sidebar">
      <a href="/dashboard" class="brand">
  <span>Lumi</span>
</a>

      <p class="navLabel">WORKSPACE</p>

      <nav class="navigation">
        <a href="/dashboard" class="navLink">
          <span>🏡</span> Dashboard
        </a>
        <a href="/task" class="navLink">
          <span>🌱</span> My Tasks
        </a>
        <a href="/calendar" class="navLink">
          <span>📅</span> Calendar
        </a>
        <a href="/notes" class="navLink">
          <span>📝</span> Notes
        </a>
        <a href="/lessons" class="navLink active">
          <span>📚</span> Lessons
        </a>
        <a href="/dailyHabits" class="navLink">
          <span>🌷</span> Daily Habits
        </a>
        <a href="/focusSession" class="navLink">
          <span>⏳</span> Focus Session
        </a>
      </nav>

      <div class="sidebarBottom">
        
        
        <button id="logoutBtn" class="logoutButton" type="button">
          Log out
        </button>
      </div>
    </aside>

    <main class="mainContent">

      <header class="pageHeader">
        <div>
          
          <h1>Lessons & Materials</h1>
          
        </div>

        <button id="addSubjectBtn" class="primaryButton" type="button">
          + Add Subject
        </button>
      </header>

      <section class="overviewCard">
        <div class="overviewText">
          <p class="eyebrow">YOUR PROGRESS</p>
          <h2>Every lesson brings you closer ✨</h2>
          

          <div class="progressNumbers">
            <span>
              <strong id="completedCount"><%= completedCount %></strong>
              completed
            </span>
            <span>
              <strong id="totalCount"><%= lessons.length %></strong>
              total lessons
            </span>
          </div>

          <div class="progressTrack">
                  <div
                  id="overallProgressBar"
                  class="progressFill"
                  ></div>
          </div>

          <p class="progressCaption" id="overallProgressText">
            <%= progress %>% completed
          </p>
        </div>

        
      </section>

      <section class="subjectSection">
        <div class="sectionHeader">
          <div>
            <h2>My Subjects 📚</h2>
            <p>Choose a subject to see its lessons and materials.</p>
          </div>
        </div>

        <div class="subjectControls">
          <label for="subjectSelect">Current subject</label>

          <select id="subjectSelect">
            <option value="all">All subjects</option>
            <% subjects.forEach(subject => { %>
              <option value="<%= subject._id %>">
                <%= subject.name %>
              </option>
            <% }) %>
          </select>

          <button id="addLessonBtn" class="primaryButton" type="button">
            + Add Lesson
          </button>

          <button id="addMaterialBtn" class="secondaryButton" type="button">
            + Add Material
          </button>
        </div>
      </section>

      <div class="contentGrid">

        <section class="lessonsPanel">
          <div class="sectionHeader">
            <div>
              <h2>My Lessons ✏️</h2>
              <p id="lessonSectionSubtitle">Your learning checklist.</p>
            </div>
          </div>

          <div id="lessonList" class="lessonList">
            <% if (lessons.length === 0) { %>
              <div class="emptyState" id="noLessonsMessage">
                <span>🌱</span>
                <h3>No lessons yet!</h3>
                <p>Add your first lesson and start learning.</p>
              </div>
            <% } else { %>
              <% lessons.forEach(lesson => { %>
                <article
                  class="lessonItem <%= lesson.status === 'completed' ? 'isCompleted' : '' %>"
                  data-lesson-id="<%= lesson._id %>"
                  data-subject-id="<%= lesson.subject?._id || lesson.subject %>"
                  data-status="<%= lesson.status %>"
                >
                  <label class="lessonCheckboxLabel">
                    <input
                      type="checkbox"
                      class="lessonCheckbox"
                      <%= lesson.status === 'completed' ? 'checked' : '' %>
                    >
                    <span class="customCheckbox"></span>
                  </label>

                  <div class="lessonInfo">
                    <h3 class="lessonTitle"><%= lesson.title %></h3>
                    <p class="lessonSubject">
                      <%= lesson.subject?.name || 'Subject' %>
                    </p>
                  </div>
                  <button
                    type="button"
                    class="deleteItemBtn"
                    data-delete-type="lessons"
                    data-id="<%= lesson._id %>"
                    aria-label="Delete lesson">
                    🗑️
                  </button>
                  <span class="lessonStatus">
                    <%= lesson.status === 'completed' ? 'Completed' : 'In progress' %>
                  </span>
                </article>
              <% }) %>
            <% } %>
          </div>

          <div class="emptyState hidden" id="noFilteredLessons">
            <span>🌷</span>
            <h3>No lessons in this subject yet.</h3>
            <p>Add a lesson to get started.</p>
          </div>
        </section>

        <aside class="materialsPanel">
          <div class="sectionHeader">
            <div>
              <h2>Course Materials 📎</h2>
              <p>Keep your useful links in one place.</p>
            </div>
          </div>

          <div id="materialList" class="materialList">
            <% if (materials.length === 0) { %>
              <div class="emptyState" id="noMaterialsMessage">
                <span>📖</span>
                <h3>No materials yet</h3>
                <p>Add links to slides, PDFs, videos, or notes.</p>
              </div>
            <% } else { %>
              <% materials.forEach(material => { %>
                <article
                  class="materialItem"
                  data-subject-id="<%= material.subject?._id || material.subject %>"
                >
                  <div class="materialIcon">📄</div>
                  <div class="materialInfo">
                    <a
                      href="<%= material.url %>"
                      target="_blank"
                      rel="noopener noreferrer"
                      class="materialTitle"
                    >
                      <%= material.title %>
                    </a>
                    <p><%= material.subject?.name || 'Subject' %></p>
                  </div>
                  <a
                    href="<%= material.url %>"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="openMaterial"
                    aria-label="Open <%= material.title %>"
                  >↗</a>
                  <button
                    type="button"
                    class="deleteItemBtn"
                    data-delete-type="materials"
                    data-id="<%= material._id %>"
                    aria-label="Delete course material">
                    🗑️
                  </button>
                </article>
              <% }) %>
            <% } %>
          </div>

          <div class="emptyState hidden" id="noFilteredMaterials">
            <span>🌼</span>
            <h3>No materials for this subject.</h3>
            <p>Add a useful link whenever you're ready.</p>
          </div>
        </aside>

      </div>

      

    </main>
  </div>

  
  <div class="modalOverlay hidden" id="subjectModal">
    <div class="modalCard">
      <button class="closeModal" type="button" data-close="subjectModal">×</button>
      <p class="eyebrow">NEW LEARNING SPACE 🌷</p>
      <h2>Add a Subject</h2>
      <p class="modalDescription">Create a subject to organize your lessons.</p>

      <form id="subjectForm">
        <label for="subjectName">Subject name</label>
        <input
          type="text"
          id="subjectName"
          name="name"
          placeholder="e.g. Data Structures"
          maxlength="100"
          required
        >
        <button class="primaryButton fullWidth" type="submit">
          Save Subject
        </button>
      </form>
    </div>
  </div>

  
  <div class="modalOverlay hidden" id="lessonModal">
    <div class="modalCard">
      <button class="closeModal" type="button" data-close="lessonModal">×</button>
      <p class="eyebrow">ONE STEP AT A TIME ✏️</p>
      <h2>Add a Lesson</h2>
      <p class="modalDescription">Add a topic you want to study.</p>

      <form id="lessonForm">
        <label for="lessonTitleInput">Lesson title</label>
        <input
          type="text"
          id="lessonTitleInput"
          name="title"
          placeholder="e.g. Linked Lists"
          maxlength="200"
          required
        >

        <label for="lessonSubjectSelect">Subject</label>
        <select id="lessonSubjectSelect" name="subjectId" required>
          <option value="">Choose a subject</option>
          <% subjects.forEach(subject => { %>
            <option value="<%= subject._id %>"><%= subject.name %></option>
          <% }) %>
        </select>

        <button class="primaryButton fullWidth" type="submit">
          Save Lesson
        </button>
      </form>
    </div>
  </div>

  
  <div class="modalOverlay hidden" id="materialModal">
    <div class="modalCard">
      <button class="closeModal" type="button" data-close="materialModal">×</button>
      <p class="eyebrow">YOUR STUDY TOOLKIT 📎</p>
      <h2>Add Course Material</h2>
      <p class="modalDescription">
        Save a link to a PDF, lecture video, slides, or other resource.
      </p>

      <form id="materialForm">
        <label for="materialTitleInput">Material title</label>
        <input
          type="text"
          id="materialTitleInput"
          name="title"
          placeholder="e.g. Week 3 Lecture Slides"
          maxlength="200"
          required
        >

        <label for="materialUrlInput">Resource URL</label>
        <input
          type="url"
          id="materialUrlInput"
          name="url"
          placeholder="https://..."
          required
        >

        <label for="materialSubjectSelect">Subject</label>
        <select id="materialSubjectSelect" name="subjectId" required>
          <option value="">Choose a subject</option>
          <% subjects.forEach(subject => { %>
            <option value="<%= subject._id %>"><%= subject.name %></option>
          <% }) %>
        </select>

        <button class="primaryButton fullWidth" type="submit">
          Save Material
        </button>
      </form>
    </div>
  </div>

  <div id="toast" class="toast" role="status" aria-live="polite"></div>

  <script id="lessonsPageData" type="application/json"><%- JSON.stringify({ subjects, lessons, materials }).replace(/</g, "\\u003c") %></script>

  <script>
    const pageData = JSON.parse(
      document.getElementById("lessonsPageData").textContent
    );

    let subjects = pageData.subjects || [];
    let lessons = pageData.lessons || [];
    let materials = pageData.materials || [];

    const subjectSelect = document.getElementById("subjectSelect");
    const lessonSubjectSelect = document.getElementById("lessonSubjectSelect");
    const materialSubjectSelect = document.getElementById("materialSubjectSelect");

    const lessonList = document.getElementById("lessonList");
    const materialList = document.getElementById("materialList");

    const noLessonsMessage = document.getElementById("noLessonsMessage");
    const noMaterialsMessage = document.getElementById("noMaterialsMessage");

    let toastTimeout;

    function showToast(message, isError = false) {
      const toast = document.getElementById("toast");
      toast.textContent = message;
      toast.classList.toggle("error", isError);
      toast.classList.add("show");

      clearTimeout(toastTimeout);

      toastTimeout = setTimeout(() => {
        toast.classList.remove("show");
      }, 3000);
    }

    async function apiRequest(url, options = {}) {
      const response = await fetch(url, {
        ...options,
        headers: {
          "Content-Type": "application/json",
          ...(options.headers || {}),
        },
      });

      const result = await response.json().catch(() => ({}));

      if (!response.ok) {
        throw new Error(result.message || "Something went wrong.");
      }

      return result;
    }

    function getSelectedSubject() {
      return subjectSelect.value;
    }

    function updateSubjectOptions() {
      const currentMainValue = subjectSelect.value || "all";
      const currentLessonValue = lessonSubjectSelect.value;
      const currentMaterialValue = materialSubjectSelect.value;

      subjectSelect.innerHTML = "";
      subjectSelect.add(new Option("All subjects", "all"));

      lessonSubjectSelect.innerHTML = "";
      lessonSubjectSelect.add(new Option("Choose a subject", ""));

      materialSubjectSelect.innerHTML = "";
      materialSubjectSelect.add(new Option("Choose a subject", ""));

      subjects.forEach(subject => {
        const id = String(subject._id);

        subjectSelect.add(new Option(subject.name, id));
        lessonSubjectSelect.add(new Option(subject.name, id));
        materialSubjectSelect.add(new Option(subject.name, id));
      });

      if (
        [...subjectSelect.options].some(option => option.value === currentMainValue)
      ) {
        subjectSelect.value = currentMainValue;
      }

      if (
        [...lessonSubjectSelect.options].some(option => option.value === currentLessonValue)
      ) {
        lessonSubjectSelect.value = currentLessonValue;
      }

      if (
        [...materialSubjectSelect.options].some(option => option.value === currentMaterialValue)
      ) {
        materialSubjectSelect.value = currentMaterialValue;
      }
    }

    function renderLessons() {
      const selectedSubject = getSelectedSubject();

      const filteredLessons = lessons.filter(lesson => {
        const lessonSubjectId = String(
          lesson.subject?._id || lesson.subject
        );

        return selectedSubject === "all" ||
          lessonSubjectId === selectedSubject;
      });

      lessonList.innerHTML = "";

      if (filteredLessons.length === 0) {
        lessonList.innerHTML = `
          <div class="emptyState">
            <span>🌱</span>
            <h3>${selectedSubject === "all" ? "No lessons yet!" : "No lessons in this subject yet."}</h3>
            <p>Add a lesson and start learning.</p>
          </div>
        `;
      } else {
        filteredLessons.forEach(lesson => {
          const isCompleted = lesson.status === "completed";
          const subject = subjects.find(
            item => String(item._id) === String(
              lesson.subject?._id || lesson.subject
            )
          );

          const article = document.createElement("article");
          article.className = `lessonItem ${isCompleted ? "isCompleted" : ""}`;
          article.dataset.lessonId = lesson._id;
          article.dataset.subjectId = lesson.subject?._id || lesson.subject;
          article.dataset.status = lesson.status;

          const label = document.createElement("label");
          label.className = "lessonCheckboxLabel";

          const checkbox = document.createElement("input");
          checkbox.type = "checkbox";
          checkbox.className = "lessonCheckbox";
          checkbox.checked = isCompleted;
          checkbox.setAttribute("aria-label", `Mark ${lesson.title} completed`);

          const customCheckbox = document.createElement("span");
          customCheckbox.className = "customCheckbox";

          label.append(checkbox, customCheckbox);

          const info = document.createElement("div");
          info.className = "lessonInfo";

          const title = document.createElement("h3");
          title.className = "lessonTitle";
          title.textContent = lesson.title;

          const subjectName = document.createElement("p");
          subjectName.className = "lessonSubject";
          subjectName.textContent = subject?.name || lesson.subject?.name || "Subject";

          info.append(title, subjectName);

          const status = document.createElement("span");
          status.className = "lessonStatus";
          status.textContent = isCompleted ? "Completed" : "In progress";

          const deleteButton = document.createElement("button");
deleteButton.type = "button";
deleteButton.className = "deleteItemBtn";
deleteButton.dataset.deleteType = "lessons";
deleteButton.dataset.id = lesson._id;
deleteButton.setAttribute("aria-label", "Delete lesson");
deleteButton.textContent = "🗑️";

article.append(label, info, deleteButton, status);
          lessonList.appendChild(article);
        });
      }

      updateProgress();
    }

    function renderMaterials() {
      const selectedSubject = getSelectedSubject();

      const filteredMaterials = materials.filter(material => {
        const materialSubjectId = String(
          material.subject?._id || material.subject
        );

        return selectedSubject === "all" ||
          materialSubjectId === selectedSubject;
      });

      materialList.innerHTML = "";

      if (filteredMaterials.length === 0) {
        materialList.innerHTML = `
          <div class="emptyState">
            <span>📖</span>
            <h3>No materials yet</h3>
            <p>Add links to slides, PDFs, videos, or notes.</p>
          </div>
        `;
        return;
      }

      filteredMaterials.forEach(material => {
        const subject = subjects.find(
          item => String(item._id) === String(
            material.subject?._id || material.subject
          )
        );

        const article = document.createElement("article");
        article.className = "materialItem";
        article.dataset.subjectId = material.subject?._id || material.subject;

        const icon = document.createElement("div");
        icon.className = "materialIcon";
        icon.textContent = "📄";

        const info = document.createElement("div");
        info.className = "materialInfo";

        const title = document.createElement("a");
        title.className = "materialTitle";
        title.textContent = material.title;
        title.href = material.url;
        title.target = "_blank";
        title.rel = "noopener noreferrer";

        const subjectName = document.createElement("p");
        subjectName.textContent = subject?.name || material.subject?.name || "Subject";

        info.append(title, subjectName);

        const openLink = document.createElement("a");
        openLink.className = "openMaterial";
        openLink.href = material.url;
        openLink.target = "_blank";
        openLink.rel = "noopener noreferrer";
        openLink.textContent = "↗";
        openLink.setAttribute("aria-label", `Open ${material.title}`);

        const deleteButton = document.createElement("button");
        deleteButton.type = "button";
        deleteButton.className = "deleteItemBtn";
        deleteButton.dataset.deleteType = "materials";
        deleteButton.dataset.id = material._id;
        deleteButton.setAttribute("aria-label", "Delete course material");
        deleteButton.textContent = "🗑️";

        article.append(icon, info, openLink, deleteButton);
        materialList.appendChild(article);
      });
    }

    function updateProgress() {
  const completedCount = lessons.filter(
    lesson => lesson.status === "completed"
  ).length;

  const totalCount = lessons.length;

  const progress = totalCount === 0
    ? 0
    : Math.round((completedCount / totalCount) * 100);

  document.getElementById("completedCount").textContent = completedCount;
  document.getElementById("totalCount").textContent = totalCount;
  document.getElementById("overallProgressBar").style.width = `${progress}%`;
  document.getElementById("overallProgressText").textContent =
    `${progress}% completed`;
}

    function openModal(id) {
      if (id === "lessonModal" && subjects.length === 0) {
        showToast("Add a subject before adding a lesson.", true);
        return;
      }

      if (id === "materialModal" && subjects.length === 0) {
        showToast("Add a subject before adding course material.", true);
        return;
      }

      document.getElementById(id).classList.remove("hidden");

      if (id === "lessonModal" && getSelectedSubject() !== "all") {
        lessonSubjectSelect.value = getSelectedSubject();
      }

      if (id === "materialModal" && getSelectedSubject() !== "all") {
        materialSubjectSelect.value = getSelectedSubject();
      }
    }

    function closeModal(id) {
      document.getElementById(id).classList.add("hidden");
    }

    document.getElementById("addSubjectBtn").addEventListener("click", () => {
      openModal("subjectModal");
    });

    document.getElementById("addLessonBtn").addEventListener("click", () => {
      openModal("lessonModal");
    });

    document.getElementById("addMaterialBtn").addEventListener("click", () => {
      openModal("materialModal");
    });

    document.querySelectorAll("[data-close]").forEach(button => {
      button.addEventListener("click", () => {
        closeModal(button.dataset.close);
      });
    });

    document.querySelectorAll(".modalOverlay").forEach(overlay => {
      overlay.addEventListener("click", event => {
        if (event.target === overlay) {
          overlay.classList.add("hidden");
        }
      });
    });

    document.addEventListener("keydown", event => {
      if (event.key === "Escape") {
        document.querySelectorAll(".modalOverlay").forEach(modal => {
          modal.classList.add("hidden");
        });
      }
    });

    subjectSelect.addEventListener("change", () => {
      renderLessons();
      renderMaterials();
    });

    document.getElementById("subjectForm").addEventListener("submit", async event => {
      event.preventDefault();

      const name = document.getElementById("subjectName").value.trim();

      try {
        const result = await apiRequest("/lessons/subjects", {
          method: "POST",
          body: JSON.stringify({ name }),
        });

        subjects.push(result.subject);
        subjects.sort((a, b) => a.name.localeCompare(b.name));

        updateSubjectOptions();

        subjectSelect.value = String(result.subject._id);
        lessonSubjectSelect.value = String(result.subject._id);
        materialSubjectSelect.value = String(result.subject._id);

        document.getElementById("subjectForm").reset();
        closeModal("subjectModal");

        renderLessons();
        renderMaterials();

        showToast(result.message || "Subject added!");
      } catch (error) {
        showToast(error.message, true);
      }
    });

    document.getElementById("lessonForm").addEventListener("submit", async event => {
      event.preventDefault();

      const title = document.getElementById("lessonTitleInput").value.trim();
      const subjectId = lessonSubjectSelect.value;

      try {
        const result = await apiRequest("/lessons/lessons", {
          method: "POST",
          body: JSON.stringify({ title, subjectId }),
        });

        lessons.unshift(result.lesson);

        subjectSelect.value = String(subjectId);

        document.getElementById("lessonForm").reset();
        closeModal("lessonModal");

        renderLessons();
        renderMaterials();

        showToast(result.message || "Lesson added!");
      } catch (error) {
        showToast(error.message, true);
      }
    });

    document.getElementById("materialForm").addEventListener("submit", async event => {
      event.preventDefault();

      const title = document.getElementById("materialTitleInput").value.trim();
      const url = document.getElementById("materialUrlInput").value.trim();
      const subjectId = materialSubjectSelect.value;

      try {
        const result = await apiRequest("/lessons/materials", {
          method: "POST",
          body: JSON.stringify({ title, url, subjectId }),
        });

        materials.unshift(result.material);

        subjectSelect.value = String(subjectId);

        document.getElementById("materialForm").reset();
        closeModal("materialModal");

        renderLessons();
        renderMaterials();

        showToast(result.message || "Course material added!");
      } catch (error) {
        showToast(error.message, true);
      }
    });

    lessonList.addEventListener("change", async event => {
      if (!event.target.matches(".lessonCheckbox")) {
        return;
      }

      const checkbox = event.target;
      const article = checkbox.closest(".lessonItem");
      const lessonId = article.dataset.lessonId;

      const lesson = lessons.find(
        item => String(item._id) === String(lessonId)
      );

      if (!lesson) {
        return;
      }

      const previousStatus = lesson.status;
      const newStatus = checkbox.checked ? "completed" : "inProgress";

      checkbox.disabled = true;

      try {
        await apiRequest(`/lessons/lessons/${lessonId}`, {
          method: "PATCH",
          body: JSON.stringify({ status: newStatus }),
        });

        lesson.status = newStatus;

        renderLessons();

        showToast(
          newStatus === "completed"
            ? "Lesson completed! Great job 🌷"
            : "Lesson marked as in progress."
        );
      } catch (error) {
        lesson.status = previousStatus;
        checkbox.checked = previousStatus === "completed";
        showToast(error.message, true);
      } finally {
        checkbox.disabled = false;
      }
    });

    document.getElementById("logoutBtn").addEventListener("click", async () => {
      try {
        const response = await fetch("/logout", {
          method: "DELETE",
        });

        if (!response.ok) {
          throw new Error("Could not log out. Please try again.");
        }

        window.location.href = "/";
      } catch (error) {
        showToast(error.message, true);
      }
    });
    document.addEventListener("click", async (event) => {
  const button = event.target.closest(".deleteItemBtn");

  if (!button) return;

  const confirmed = confirm("Are you sure you want to delete this item?");
  if (!confirmed) return;

  const type = button.dataset.deleteType;
  const id = button.dataset.id;

  try {
    const response = await fetch(`/lessons/${type}/${id}`, {
      method: "DELETE",
    });

    if (!response.ok) {
      throw new Error("Could not delete item");
    }

    window.location.reload();
  } catch (error) {
    alert("Failed to delete. Please try again.");
    console.error(error);
  }
});

    updateSubjectOptions();
    renderLessons();
    renderMaterials();
  </script>
</body>
</html>