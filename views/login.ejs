<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="../stylesheet/login.css" >
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,200..1000;1,200..1000&family=Quicksand:wght@300..700&display=swap" rel="stylesheet">
</head>
    
<body>
    <div class="main-img">
        <img id="background"src="../images/Pastel Capybara Study Nook.png">
    </div>

    <div class="box">
       
       
       <div class="info">

        <img id="logo" src="../images/Lumi Capybara Study Planner.png" height="150px" width="auto">
        <br>
        <input id="username" type="text" placeholder="Username or Email" required>
        <input id="key"type="password" placeholder="Password" required>
        <br>
        <button id="loginBtn">Login</button>

        <p id="signUp">Don't have an account?<a id="signUPLink" href="/signup">Create One</a></p>
       </div>
        
    </div>
</body>
</html>