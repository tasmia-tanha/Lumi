
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="../stylesheet/login.css" />
    <link rel="icon" type="image/png" href="../images/Lumi Capybara Study Planner.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,200..1000;1,200..1000&family=Quicksand:wght@300..700&display=swap"
      rel="stylesheet"
    />
  </head>

<body>
  <main class="loginPage">
    <img
      id="background"
      src="../images/Cozy Pastel Study Nook.png"
      alt=""
    />

    <section class="formPanel">
      <div class="loginCard">
        <img
          id="logo"
          src="../images/Lumi Capybara Study Planner.png"
          alt="Lumi"
        />

        <p class="welcomeLabel">WELCOME BACK</p>
        <h2>Let's get cozy.</h2>
        <p class="subtitle">Your little corner of productivity awaits.</p>

        <form id="loginForm" action="/" method="POST" novalidate>
          <label for="username">Username or email</label>
          <input
            id="username"
            type="text"
            placeholder="Enter your username or email"
            name="username"
            value="<%= data.username %>"
            spellcheck="false"
            required
          />

          <label for="key">Password</label>
          <input
            id="key"
            type="password"
            placeholder="Enter your password"
            name="password"
            required
          />

          <% if (errors && errors.common) { %>
            <p class="error visible"><%= errors.common.msg %></p>
          <% } else { %>
            <p class="error"></p>
          <% } %>

          <button id="loginBtn" type="submit">
            Log in to Lumi <span>→</span>
          </button>
        </form>

        <p id="signUp">
          New to Lumi?
          <a id="signUPLink" href="/signup">Create an account</a>
        </p>

        <p class="bottomNote">
          Made for your little everyday wins <span>♡</span>
        </p>
      </div>
    </section>
  </main>
</body>

</html>
