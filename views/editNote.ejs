<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title><%= title %></title>

  <link rel="stylesheet" href="/stylesheet/notes.css">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link
    href="https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,200..1000;1,200..1000&family=Quicksand:wght@300..700&display=swap"
    rel="stylesheet"
  >
</head>

<body>

  <div class="main">

    <aside class="sidebar">

      <a href="/dashboard" class="brand">
        <span>Lumi</span>
      </a>

      <p class="navLabel">WORKSPACE</p>

      <nav class="navigation">

        <a href="/dashboard" class="navLink">
          <span>🏡</span> Dashboard
        </a>

        <a href="/task" class="navLink">
          <span>🌱</span> My Tasks
        </a>

        <a href="/calendar" class="navLink">
          <span>📅</span> Calendar
        </a>

        <a href="/notes" class="navLink active">
          <span>📝</span> Notes
        </a>

        <a href="/lessons" class="navLink">
          <span>📚</span> Lessons
        </a>

        <a href="/dailyHabits" class="navLink">
          <span>🌷</span> Daily Habits
        </a>

        <a href="/focusSession" class="navLink">
          <span>⏳</span> Focus Session
        </a>

      </nav>

      <div class="sidebarBottom">
        <button id="logoutBtn" class="logoutButton" type="button">
          Log out
        </button>
      </div>

    </aside>


    <main class="notesWorkspace">

      <div class="notesTopBar">

        <a href="/notes" class="newNoteBtn">
          ← Back to Notes
        </a>

      </div>


      <div class="editNoteCard">

        <div class="editNoteHeader">
          <h2>Edit Note</h2>
        </div>


        <form
          class="editNoteForm"
          method="POST"
          action="/notes/<%= note._id %>"
        >

          <label for="title">Title</label>

          <input
            type="text"
            id="title"
            name="title"
            value="<%= note.title %>"
            maxlength="150"
            required
          >


          <label for="content">Content</label>

          <textarea
            id="content"
            name="content"
            rows="15"
            required
          ><%= note.content %></textarea>


          <label for="tags">Tags</label>

          <input
            type="text"
            id="tags"
            name="tags"
            value="<%= (note.tags || []).join(', ') %>"
            placeholder="Example: CS101, Coding, ExamPrep"
          >


          <div class="editNoteActions">

            <button type="submit" class="newNoteBtn">
              Save Changes
            </button>

            <a href="/notes" class="cancelNoteBtn">
              Cancel
            </a>

          </div>

        </form>

      </div>

    </main>

  </div>

</body>
</html>