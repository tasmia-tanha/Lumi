<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="../stylesheet/task.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,200..1000;1,200..1000&family=Quicksand:wght@300..700&display=swap" rel="stylesheet">
  </head>
  <body>
    <div class="main">
      
      <div class="navbar" style="grid-area: box-1">
        <img id="nameLogo" src="../images/Lumi Sprout Heart Logo.png" />
        <ul id="list" style="list-style-type: none; padding: 0px">
          <li class="items">
            <button class="navBtn">
              <a class="navLinks" href="/dashboard">Dashboard</a>
            </button>
          </li>
          <li class="items">
            <button class="navBtn">
              <a class="navLinks" href="/task">Tasks</a>
            </button>
          </li>
          <li class="items">
            <button class="navBtn">
              <a class="navLinks" href="/calendar">Calendar</a>
            </button>
          </li>
          <li class="items">
            <button class="navBtn">
              <a class="navLinks" href="/notes">Note</a>
            </button>
          </li>
          <li class="items">
            <button class="navBtn">
              <a class="navLinks" href="/lessons">Lessons</a>
            </button>
          </li>
          <li class="items">
            <button class="navBtn">
              <a class="navLinks" href="/dailyHabits">Daily Habits</a>
            </button>
          </li>
          <li class="items">
            <button class="navBtn">
              <a class="navLinks" href="/focusSession">Focus Session</a>
            </button>
          </li>
        </ul>

        <button class="logout">Log Out</button>
      </div>

      <main class="taskPage" style="grid-area: box-2">
        <div class="taskTop">
          <h1>Tasks</h1>

          <div class="progressSection">
            <div class="progressCircle">
              <span>65%</span>
            </div>
            <p>Completed</p>
          </div>
        </div>

        <form action="/task" method="POST">
          <input type="text" name="title" placeholder="Enter a new task" required>
          <button class="addTask" type="submit">+ Add Task</button>
        </form>
        

        <div class="taskList">
          <% tasks.forEach(task=>{ %>
          <div class="taskItem">
            <input type="checkbox" data-task-id="<%= task._id%>" <%= task.completed? "checked":"" %> />
            <div class="taskInfo">
              <h3><%=task.title%></h3>
              
            </div>
            <span class="priority high">High</span>
          </div>
          <% }) %>

          

            
        </div>
      </main>

      <div class="capyArea" style="grid-area: box-3">
        <img
          class="capyImage"
          src="../images/Cozy Capybara’s All Done Bedtime.png"
          alt="Sleeping capybara after completing tasks"
        />
      </div>
    </div>
  </body>

  <script>
    document.querySelectorAll(".taskItem input[type='checkbox']").forEach((checkbox)=>{

      checkbox.addEventListener("change",async function () {
        const taskId=this.dataset.taskId;
        try{
          const response=await fetch(`/task/${taskId}`,{
            method:"PATCH",
            headers:{
              "Content-Type":"application/json",
            },
            body:JSON.stringify({
              completed:this.checked
            }),
          })
          if(!response.ok){
            throw new Error("Failed to update task!")
          }

        }catch(error){
          console.log(error);
          this.checked=!this.checked;
          alert("Failed to update task!Please try again")
        }
      });
    });
  </script>
</html>
