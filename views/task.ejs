<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="../stylesheet/task.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,200..1000;1,200..1000&family=Quicksand:wght@300..700&display=swap" rel="stylesheet">
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css"
    />
    <script src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
  
  </head>
  <body>
    <div class="main">
      
      <div class="navbar" style="grid-area: box-1">
        <img id="nameLogo" src="../images/Lumi Sprout Heart Logo.png" />
        <ul id="list" style="list-style-type: none; padding: 0px">
          <li class="items">
            <button class="navBtn">
              <a class="navLinks" href="/dashboard">Dashboard</a>
            </button>
          </li>
          <li class="items">
            <button class="navBtn">
              <a class="navLinks" href="/task">Tasks</a>
            </button>
          </li>
          <li class="items">
            <button class="navBtn">
              <a class="navLinks" href="/calendar">Calendar</a>
            </button>
          </li>
          <li class="items">
            <button class="navBtn">
              <a class="navLinks" href="/notes">Note</a>
            </button>
          </li>
          <li class="items">
            <button class="navBtn">
              <a class="navLinks" href="/lessons">Lessons</a>
            </button>
          </li>
          <li class="items">
            <button class="navBtn">
              <a class="navLinks" href="/dailyHabits">Daily Habits</a>
            </button>
          </li>
          <li class="items">
            <button class="navBtn">
              <a class="navLinks" href="/focusSession">Focus Session</a>
            </button>
          </li>
        </ul>

        <button class="logout" onclick="logout()">Log Out</button>
      </div>

      <main class="taskPage" style="grid-area: box-2">
        <div class="taskTop">
          <h1>Tasks</h1>

          
        </div>

        <form action="/task" method="POST">
          <input type="text" name="title" placeholder="Enter a new task" required>
          <select name="priority">
            <option value="high">High</option>
            <option value="medium" selected>Medium</option>
            <option value="low">Low</option>
          </select>
          <button class="addTask" type="submit">+ Add Task</button>
        </form>
        
        <h4 class="filterText">Filter by:</h4>
        <select id="priorityFilter">
          <option value="all" selected>All</option>
          <option value="high">High</option>
          <option value="medium">Medium</option>
          <option value="low">Low</option>
        </select>

        <div class="taskList">
          <h2 id="activeHeading">
              Active Tasks <span id="activeCount"><%= activeTasks.length %></span>
          </h2>

          <div id="activeList">
          
          <p
            id="noActiveTasks"
            class="emptyMessage"
            <%= activeTasks.length === 0 ? "" : 'hidden' %>
          >
          No active tasks. Time to relax! 🌱
          </p>
          
          <% activeTasks.forEach((task)=>{ %>
            <div class="taskItem">
            <input type="checkbox" data-task-id="<%= task._id%>" <%= task.completed? "checked":"" %> />
            <div class="taskInfo">
              <h3 class="<%= task.completed? 'completed':'' %>"><%=task.title%></h3>
              
            </div>
            <span class="priority <%=task.priority%>"><%= task.priority%></span>
             <button
              type="button"
              class="deleteTask"
              data-task-id="<%= task._id %>"
              aria-label="Delete <%= task.title %>"
              >
              🗑
            </button>
          </div>
         <% }) %>
          </div>
         <h2 id="completedHeading">
          Completed Tasks <span id="completedCount"><%= completedTasks.length %></span>
          <button type="button" id="toggleCompleted">Hide</button>
          </h2>
          <button class="clearButton"><span class="clearCompleted">Clear Completed Tasks</span></button>

          <div id="completedList">
          
          <p
          id="noCompletedTasks"
          class="emptyMessage"
          <%= completedTasks.length === 0 ? "" : 'hidden' %>
          >
          No completed tasks yet.
          </p>
          
          <% completedTasks.forEach((task)=>{ %>
            <div class="taskItem">
            <input type="checkbox" data-task-id="<%= task._id%>" <%= task.completed? "checked":"" %> />
            <div class="taskInfo">
              <h3 class="<%= task.completed? 'completed':'' %>"><%=task.title%></h3>
              
            </div>
            
            <span class="priority <%=task.priority%>"><%= task.priority%></span>
            <button
            type="button"
            class="deleteTask"
            data-task-id="<%= task._id %>"
            aria-label="Delete <%= task.title %>"
            >
              🗑
            </button>
          </div>
         <% }) %>
          </div>
        </div>
      </main>

      <div class="capyArea" style="grid-area: box-3">
        <img
        id="capybaraImage"
          class="capyImage"
          src="/images/Cozy Capybara’s All Done Bedtime.png"
          alt="Sleeping capybara after completing tasks"
        />
      </div>
    </div>
  </body>

  <script>
    const logoutToast = Toastify({
      text: "You are being logged out",
      duration: 1000,
    });

   async function logout(){
     
    try{
      const response=await fetch("/logout",{
        method:"DELETE"
      });

      if(!response.ok){
        throw new Error("Logout failed!");
      }
      logoutToast.showToast();
      setTimeout(()=>{
        window.location.href="/";
      },1500)
    }catch(error){
      console.error(error);
      alert("Could not log out. Please try again.");
    }
      
    }
    //clear complted tasks
    const btn=document.querySelector(".clearButton");
    btn.addEventListener("click",async function() {
      const Tasks = [...document.querySelectorAll(".taskItem")];
      Tasks.forEach(async(task)=>{
        
        const isCompleted=task.querySelector("input[type='checkbox']").checked;
        const id = task.querySelector("input[type='checkbox']").dataset.taskId;
        if(isCompleted){
          try{
            const response=await fetch(`/task/${id}`,{
              method:"DELETE"
            })

            if(!response.ok){
              throw new Error("Failed to clear the completed tasks!")
            }

            task.remove();
            document.querySelector("#completedCount").textContent =0;
          }catch(error){
            console.log(error);
            alert("Failed to clear the completed tasks!")
          }
        }
      })
    })
    //delete
    
    document.querySelectorAll(".deleteTask").forEach((button) => {
    button.addEventListener("click", async function () {
    const taskId = this.dataset.taskId;
    const taskItem = this.closest(".taskItem");

    const confirmed = confirm("Are you sure you want to delete this task?");

    if (!confirmed) {
      return;
    }

    try {
      const response = await fetch(`/task/${taskId}`, {
        method: "DELETE",
      });

      if (!response.ok) {
        throw new Error("Failed to delete task");
      }

      
      taskItem.remove();
      const remainingTasks = [...document.querySelectorAll(".taskItem")];

      const activeCount = remainingTasks.filter(
        item => !item.querySelector("input[type='checkbox']").checked
        ).length;

      const completedCount = remainingTasks.length - activeCount;

      document.querySelector("#activeCount").textContent = activeCount;
      updateCapybaraImage();
      document.querySelector("#completedCount").textContent = completedCount;

        document.querySelector("#noActiveTasks").hidden = activeCount !== 0;
      document.querySelector("#noCompletedTasks").hidden = completedCount !== 0;


    } catch (error) {
      console.error(error);
      alert("Failed to delete task. Please try again.");
    }
  });
});

    


    //filter
    const priorityFilter=document.querySelector("#priorityFilter");
    function updateTaskFilter() {
      let visibleActive = 0;
      let visibleCompleted = 0;
      const selectedPriority = priorityFilter.value;

      document.querySelectorAll(".taskItem").forEach((taskItem) => {
      const priority = taskItem.querySelector(".priority").textContent.trim();
      const isCompleted = taskItem.querySelector("input[type='checkbox']").checked;
      const matches =
              selectedPriority === "all" || selectedPriority === priority;

      taskItem.style.display = matches ? "" : "none";

      if (matches && isCompleted) {
        visibleCompleted++;
      } else if (matches) {
        visibleActive++;
      }
    });

    const msgActive = document.querySelector("#noActiveTasks");
    const msgCompleted = document.querySelector("#noCompletedTasks");

    if (selectedPriority !== "all") {
      msgActive.textContent = `No active ${selectedPriority}-priority tasks 🌱`;
      msgCompleted.textContent = `No ${selectedPriority}-priority tasks completed yet`;
    } else {
      msgActive.textContent = "No active tasks. Time to relax 🌱";
      msgCompleted.textContent = "No tasks have been completed yet";
    }

    document.querySelector("#activeCount").textContent = visibleActive;
    document.querySelector("#completedCount").textContent = visibleCompleted;
    msgActive.hidden = visibleActive !== 0;
    msgCompleted.hidden = visibleCompleted !== 0;
    }
    priorityFilter.addEventListener("change", updateTaskFilter);
   
    //checkbox change
    document.querySelectorAll(".taskItem input[type='checkbox']").forEach((checkbox)=>{

      checkbox.addEventListener("change",async function () {
        const taskId=this.dataset.taskId;
        const taskItem = this.closest(".taskItem");
        const taskTitle = taskItem.querySelector(".taskInfo h3");
        const taskList = document.querySelector(".taskList");
        const activeHeading = [...taskList.querySelectorAll("h2")]
          .find(heading => heading.textContent.includes("Active Tasks"));
        const completedHeading = [...taskList.querySelectorAll("h2")]
          .find(heading => heading.textContent.includes("Completed Tasks"));

        taskTitle.classList.toggle("completed",this.checked);
        
        const targetList = this.checked
          ? document.querySelector("#completedList")
          : document.querySelector("#activeList");

          if (targetList) {
            targetList.appendChild(taskItem);
          }

        const taskItems = [...document.querySelectorAll(".taskItem")];

        const completedCount = taskItems.filter(
          item => item.querySelector("input[type='checkbox']").checked
          ).length;

        const activeCount = taskItems.length - completedCount;

        updateTaskFilter();
        
        updateCapybaraImage();
       

        try{
          const response=await fetch(`/task/${taskId}`,{
            method:"PATCH",
            headers:{
              "Content-Type":"application/json",
            },
            body:JSON.stringify({
              completed:this.checked
            }),
          })
          if(!response.ok){
            throw new Error("Failed to update task!")
          }

        }catch(error){
          console.log(error);
          this.checked=!this.checked;
          taskTitle.classList.toggle("completed",this.checked);
          alert("Failed to update task!Please try again");
        }
      });
    });

    //hide completed list
    const toggleBtn = document.querySelector("#toggleCompleted");
    const completedList = document.querySelector("#completedList");

    console.log("Button:", toggleBtn);
    console.log("Completed list:", completedList);

    toggleBtn.addEventListener("click", function () {
    console.log("Toggle clicked");

    completedList.style.display =
    completedList.style.display === "none" ? "flex" : "none";
    toggleBtn.textContent = completedList.style.display==="none" ? "Show" : "Hide";
});
    
    function updateCapybaraImage() {
      console.log("Active count:", document.querySelector("#activeCount").textContent);
      const activeCount = Number(
      document.querySelector("#activeCount").textContent
      );

      const capybaraImage = document.querySelector("#capybaraImage");

      if (activeCount > 0) {
        capybaraImage.src = "/images/Sleepy Capybara’s Midnight Tasks.png";
        capybaraImage.alt = "Capybara studying with unfinished tasks";
      } else {
        capybaraImage.src = "/images/Cozy Capybara’s All Done Bedtime.png";
        capybaraImage.alt = "Sleeping capybara after completing tasks";
      }
  }

  updateCapybaraImage();
  
  </script>
</html>
