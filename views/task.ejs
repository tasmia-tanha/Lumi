<!doctype html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="../stylesheet/task.css" />
  <link rel="icon" type="image/png" href="../images/Lumi Capybara Study Planner.png" />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,200..1000;1,200..1000&family=Quicksand:wght@300..700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css" />
  <script src="https://cdn.jsdelivr.net/npm/toastify-js"></script>

</head>

<body>
  <div class="main">

    <aside class="sidebar">
      <a href="/dashboard" class="brand">
        <span>Lumi</span>
      </a>

      <p class="navLabel">WORKSPACE</p>

      <nav class="navigation">
        <a href="/dashboard" class="navLink">
          <span>🏡</span> Dashboard
        </a>
        <a href="/task" class="navLink active">
          <span>🌱</span> My Tasks
        </a>
        <a href="/calendar" class="navLink">
          <span>📅</span> Calendar
        </a>
        <a href="/notes" class="navLink">
          <span>📝</span> Notes
        </a>
        <a href="/lessons" class="navLink">
          <span>📚</span> Lessons
        </a>
        <a href="/dailyHabits" class="navLink">
          <span>🌷</span> Daily Habits
        </a>
        <a href="/focusSession" class="navLink">
          <span>⏳</span> Focus Session
        </a>
      </nav>

      <div class="sidebarBottom">


        <button id="logoutBtn" class="logoutButton" type="button">
          Log out
        </button>
      </div>
    </aside>

    <main class="taskPage taskPageLayout">
      <div class="taskTop">
        <h1>Tasks</h1>


      </div>

      <form id="addTaskForm" action="/task" method="POST">
        <input type="text" name="title" placeholder="Enter a new task" required>
        <select name="priority">
          <option value="high">High</option>
          <option value="medium" selected>Medium</option>
          <option value="low">Low</option>
        </select>
        <button class="addTask" id="addTaskBtn" type="submit">
          + Add Task
        </button>
      </form>

      <h4 class="filterText">Filter by:</h4>
      <select id="priorityFilter">
        <option value="all" selected>All</option>
        <option value="high">High</option>
        <option value="medium">Medium</option>
        <option value="low">Low</option>
      </select>

      <div class="taskList">
        <h2 id="activeHeading">
          Active Tasks <span id="activeCount"><%= activeTasks.length %></span>
        </h2>

        <div id="activeList">

          <p id="noActiveTasks" class="emptyMessage" <%= activeTasks.length === 0 ? "" : 'hidden' %>>
            No active tasks. Time to relax! 🌱
          </p>

          <% activeTasks.forEach((task)=>{ %>
          <div class="taskItem">
            <input type="checkbox" data-task-id="<%= task._id%>" <%= task.completed? "checked":"" %> />
            <div class="taskInfo">
              <h3 class="<%= task.completed? 'completed':'' %>"><%=task.title%></h3>

            </div>
            <span class="priority <%=task.priority%>"><%= task.priority%></span>
            <button type="button" class="deleteTask" data-task-id="<%= task._id %>" aria-label="Delete <%= task.title %>">
              🗑
            </button>
          </div>
          <% }) %>
        </div>
        <h2 id="completedHeading">
          Completed Tasks <span id="completedCount"><%= completedTasks.length %></span>
          <button type="button" id="toggleCompleted">Hide</button>
        </h2>
        <button type="button" class="clearButton"><span class="clearCompleted">Clear Completed Tasks</span></button>

        <div id="completedList">

          <p id="noCompletedTasks" class="emptyMessage" <%= completedTasks.length === 0 ? "" : 'hidden' %>>
            No completed tasks yet.
          </p>

          <% completedTasks.forEach((task)=>{ %>
          <div class="taskItem">
            <input type="checkbox" data-task-id="<%= task._id%>" <%= task.completed? "checked":"" %> />
            <div class="taskInfo">
              <h3 class="<%= task.completed? 'completed':'' %>"><%=task.title%></h3>

            </div>

            <span class="priority <%=task.priority%>"><%= task.priority%></span>
            <button type="button" class="deleteTask" data-task-id="<%= task._id %>" aria-label="Delete <%= task.title %>">
              🗑
            </button>
          </div>
          <% }) %>
        </div>
      </div>
    </main>

    <div class="capyArea capybaraLayout" >
      <img id="capybaraImage" class="capyImage" src="/images/Cozy Capybara’s All Done Bedtime.png" alt="Sleeping capybara after completing tasks" />
    </div>
  </div>
  <div class="deleteModalOverlay" id="deleteModal" hidden>
    <div class="deleteModal" role="dialog" aria-modal="true" aria-labelledby="deleteModalTitle">

      <div class="deleteModalIcon">🌸</div>

      <h2 id="deleteModalTitle">Delete this task?</h2>

      <p id="deleteModalMessage">
        Are you sure you want to delete this task?
      </p>

      <div class="deleteModalButtons">
        <button type="button" id="cancelDelete">Cancel</button>
        <button type="button" id="confirmDelete">Yes, Delete</button>
      </div>

    </div>
  </div>
</body>
<script src="/js/task.js" defer></script>

</html>