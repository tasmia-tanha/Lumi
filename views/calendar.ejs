<!doctype html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="../stylesheet/calendar.css" />
  <link rel="icon" type="image/png" href="../images/Lumi Capybara Study Planner.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,200..1000;1,200..1000&family=Quicksand:wght@300..700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css" />
  <script src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
</head>

<body>
  <div class="main">
    <aside class="sidebar">
      <a href="/dashboard" class="brand">
        <span>Lumi</span>
      </a>

      <p class="navLabel">WORKSPACE</p>

      <nav class="navigation">
        <a href="/dashboard" class="navLink"> <span>🏡</span> Dashboard </a>
        <a href="/task" class="navLink"> <span>🌱</span> My Tasks </a>
        <a href="/calendar" class="navLink active"> <span>📅</span> Calendar </a>
        <a href="/notes" class="navLink"> <span>📝</span> Notes </a>
        <a href="/lessons" class="navLink">
          <span>📚</span> Lessons
        </a>
        <a href="/dailyHabits" class="navLink">
          <span>🌷</span> Daily Habits
        </a>
        <a href="/focusSession" class="navLink">
          <span>⏳</span> Focus Session
        </a>
      </nav>

      <div class="sidebarBottom">
        <button id="logoutBtn" class="logoutButton" type="button">
          Log out
        </button>
      </div>
    </aside>

    <section class="calendarSection">
      <div class="calendarHeaderArea">
        <h2>Calendar</h2>

        <div class="calendarControls">
          <select id="monthSelect" class="calSelect">
            <option value="0" <%= new Date().getMonth() === 0 ? "selected" : "" %>>January</option>
            <option value="1" <%= new Date().getMonth() === 1 ? "selected" : "" %>>February</option>
            <option value="2" <%= new Date().getMonth() === 2 ? "selected" : "" %>>March</option>
            <option value="3" <%= new Date().getMonth() === 3 ? "selected" : "" %>>April</option>
            <option value="4" <%= new Date().getMonth() === 4 ? "selected" : "" %>>May</option>
            <option value="5" <%= new Date().getMonth() === 5 ? "selected" : "" %>>June</option>
            <option value="6" <%= new Date().getMonth() === 6 ? "selected" : "" %>>July</option>
            <option value="7" <%= new Date().getMonth() === 7 ? "selected" : "" %>>August</option>
            <option value="8" <%= new Date().getMonth() === 8 ? "selected" : "" %>>September</option>
            <option value="9" <%= new Date().getMonth() === 9 ? "selected" : "" %>>October</option>
            <option value="10" <%= new Date().getMonth() === 10 ? "selected" : "" %>>November</option>
            <option value="11" <%= new Date().getMonth() === 11 ? "selected" : "" %>>December</option>
          </select>
          <select id="yearSelect" class="calSelect"></select>
        </div>
      </div>

      <div class="calendarCard">
        <div class="weekdays">
          <span>Sun</span><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span>
        </div>

        <div class="calendarGrid is-loading"></div>
      </div>

      <div class="datePopupOverlay" id="datePopupOverlay" hidden>
        <div class="datePopup">
          <button type="button" id="closeDatePopup" class="closeDatePopup">
            &times;
          </button>

          <h2 id="popupDateTitle">Date Details</h2>

          <label for="eventTitle">Title</label>
          <input type="text" id="eventTitle" placeholder="e.g. DS CT" maxlength="30" />

          <label class="pinLabel">
            <input type="checkbox" id="pinDate" />
            Pin this date
          </label>

          <div class="timeEntries">
            <h3>Time entries</h3>
            <div id="timeEntryList"></div>
            <button type="button" id="addTimeEntry">+ Add time entry</button>
          </div>

          <button type="button" id="saveDateDetails">Save</button>
        </div>
      </div>
    </section>

    <aside class="rightPanel">
      <div class="panelCard todaysAgenda">
        <h3>Today's Agenda</h3>
        <p class="dateSub" id="todayDate"></p>
        <ul class="eventList" id="todayAgendaList">
          <% for (let i = 0; i < 3; i++) { %>
          <li class="agendaSkeleton">
            <span class="calendarSkeleton skeletonAgendaTime"></span>
            <span class="calendarSkeleton skeletonAgendaDescription"></span>
          </li>
          <% } %>
        </ul>
      </div>

      <div class="panelCard upcomingAgenda">
        <h3>Upcoming Events</h3>
        <ul class="eventList" id="upcomingEventsList">
          <% for (let i = 0; i < 3; i++) { %>
          <li class="agendaSkeleton">
            <span class="calendarSkeleton skeletonAgendaBadge"></span>
            <span class="calendarSkeleton skeletonAgendaTitle"></span>
          </li>
          <% } %>
        </ul>
      </div>
    </aside>
  </div>
</body>
<script src="/js/calendar.js" defer></script>

</html>