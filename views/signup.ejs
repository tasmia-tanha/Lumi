<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="../stylesheet/signup.css" />
  <link rel="icon" type="image/png" href="../images/Lumi Capybara Study Planner.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <link href="https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,200..1000;1,200..1000&family=Quicksand:wght@300..700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css" />
  <script src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
</head>


<body>
  <div class="main-img">
    <img id="background" src="../images/Cozy Pastel Study Nook.png" alt="" />
  </div>

  <div class="box">
    <div class="info">
      <img id="logo" src="../images/Lumi Capybara Study Planner.png" alt="Lumi" />

      <form action="/signup" method="POST" class="user_info" novalidate>
        <label for="username" class="visuallyHidden">Username</label>
        <input id="username" type="text" placeholder="Username" name="name" required aria-describedby="nameError"/>
        <p id="nameError" class="error name-error">This is error</p>

        <label for="email" class="visuallyHidden">Email</label>
        <input id="email" type="email" placeholder="Email" name="email" required aria-describedby="emailError"/>
        <p id="emailError" class="error email-error">This is error</p>

        <label for="key" class="visuallyHidden">Password</label>
        <input id="key" type="password" placeholder="Password" name="password" required aria-describedby="passwordError"/>
        <p id="passwordError" class="error password-error">This is error</p>

        <label for="confirmKey" class="visuallyHidden">Confirm Password</label>
        <input id="confirmKey" type="password" placeholder="Confirm Password" name="confirmPassword" required aria-describedby="confirmPasswordError" />
        <p id="confirmPasswordError" class="error confirm-password-error">This is error</p>

        <p class="error common-error" role="alert" aria-live="assertive">This is error</p>

        <button id="signUpBtn" type="submit">Create my account →</button>
      </form>

      <p id="login">
        Already have an account?
        <a id="loginLink" href="/">Log In</a>
      </p>
    </div>
  </div>


</body>
<script src="/js/signup.js" defer></script>
</html>