<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="../stylesheet/focusSession.css" />
  <link rel="icon" type="image/png" href="../images/Lumi Capybara Study Planner.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,200..1000;1,200..1000&family=Quicksand:wght@300..700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css" />
  <script src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
</head>

<body>
  <div class="main">
    <aside class="sidebar">
      <a href="/dashboard" class="brand">
        <span>Lumi</span>
      </a>

      <p class="navLabel">WORKSPACE</p>

      <nav class="navigation">
        <a href="/dashboard" class="navLink">
          <span>🏡</span> Dashboard
        </a>
        <a href="/task" class="navLink">
          <span>🌱</span> My Tasks
        </a>
        <a href="/calendar" class="navLink">
          <span>📅</span> Calendar
        </a>
        <a href="/notes" class="navLink">
          <span>📝</span> Notes
        </a>
        <a href="/lessons" class="navLink">
          <span>📚</span> Lessons
        </a>
        <a href="/dailyHabits" class="navLink">
          <span>🌷</span> Daily Habits
        </a>
        <a href="/focusSession" class="navLink active">
          <span>⏳</span> Focus Session
        </a>
        <a href="/account" class="navLink">
          <span>⚙️</span> Account
        </a>
      </nav>

      <div class="sidebarBottom">


        <button id="logoutBtn" class="logoutButton" type="button">
          Log out
        </button>
      </div>
    </aside>

    <main class="studyWorkspace">
      <div class="focusLayout">

        <section class="timerSection">
          <div class="timerHeader">
            <div>
              <h1 class="pageTitle">Focus Session</h1>
              <p class="subtitle">Stay focused, study better 🌱</p>
            </div>
            <span class="focusBadge">✦ Time to focus</span>
          </div>

          <div class="timerOverlayCard">
            <div class="timerTopRow">
              <span class="timerModeLabel"><span aria-hidden="true">✿</span> FOCUS TIME</span>
              <span class="timerStatus">Ready when you are</span>
            </div>

            <div class="timerDisplay">
              <span id="hours">00</span>:<span id="minutes">00</span>:<span id="seconds">00</span>
            </div>

            <div class="timerLabels">
              <span>Hours</span>
              <span>Minutes</span>
              <span>Seconds</span>
            </div>


            <div class="timerModeSelector">
              <button type="button" class="modeBtn active" data-mode="free">
                Free Study
              </button>
              <button type="button" class="modeBtn" data-mode="pomodoro">
                Pomodoro
              </button>
            </div>


            <div class="breakControls">
              <span id="timerMessage">Ready to focus?</span>
              <button type="button" id="startBreakBtn" class="modeBtn">
                ☕ Start 5-min Break
              </button>
            </div>

            <div class="timerControls">
              <button id="startBtn" type="button" class="controlBtn">
                <span class="btnIcon">▶</span> Start
              </button>
              <button id="pauseBtn" type="button" class="controlBtn">
                <span class="btnIcon">❚❚</span> Pause
              </button>
              <button id="resetBtn" type="button" class="controlBtn">
                <span class="btnIcon">↺</span> Reset
              </button>
              <button id="stopBtn" type="button" class="controlBtn stop">
                <span class="btnIcon">■</span> Stop
              </button>
            </div>
          </div>

          <div class="lastSessionCard">
            <div class="lastSessionIcon" aria-hidden="true">☕</div>
            <div>
              <span class="cardEyebrow">YOUR LAST SESSION</span>
              <h3 id="lastSessionTitle" class="focusSkeleton skeletonLastSessionTitle"></h3>
              <p id="lastSessionDetails" class="focusSkeleton skeletonLastSessionDetails"></p>
            </div>
            <span class="lastSessionDecoration">♡</span>
          </div>

          <div class="overviewGrid">
            <div class="overviewCard">
              <span class="overviewIcon" aria-hidden="true">◷</span>
              <span class="cardEyebrow">TOTAL HOURS LOGGED</span>
              <h2><span id="totalHoursText" class="focusSkeleton skeletonStatNumber"></span> <small>hrs</small></h2>
            </div>

            <div class="overviewCard">
              <span class="overviewIcon" aria-hidden="true">🔥</span>
              <span class="cardEyebrow">STUDY STREAK</span>
              <h2><span id="streakDays" class="focusSkeleton skeletonStatNumber"></span> <small>days</small></h2>
            </div>

            <div class="overviewCard">
              <span class="overviewIcon" aria-hidden="true">🌱</span>
              <span class="cardEyebrow">DAILY GOAL</span>

              <h2>
                <span id="dailyGoalOverview" class="focusSkeleton skeletonGoalNumber"></span> <small>hours</small>
              </h2>
            </div>
          </div>
        </section>


        <aside class="focusSidebar">
          <section class="sideCard pomodoroCard">
            <div class="sideCardHeading">
              <span class="sideIcon" aria-hidden="true">⏱</span>
              <div>
                <h3>Pomodoro Settings</h3>
                <p>Find your rhythm</p>
              </div>
            </div>

            <div class="durationOptions">
              <button class="durationBtn active" data-duration="25">
                <strong>25 min</strong>
                <span>Classic</span>
              </button>

              <button class="durationBtn" data-duration="50">
                <strong>50 min</strong>
                <span>Extended</span>
              </button>

              <button class="durationBtn" data-duration="custom">
                <strong>Custom</strong>
                <span>Your pace</span>
              </button>
            </div>

            <div class="customDurationBox" id="customDurationBox" hidden>
              <label for="customDurationInput">Focus duration (minutes)</label>
              <input type="number" id="customDurationInput" min="1" max="180" placeholder="Enter minutes (1–180)" />
              <button type="button" id="applyCustomDuration" class="durationBtn">
                Apply
              </button>
            </div>

            <div class="breakInfo">
              <span><span aria-hidden="true">📖</span> Study session</span>
              <strong id="studyDurationText">25 min</strong>
            </div>
            <div class="breakInfo">
              <span><span aria-hidden="true">☕</span> Short break</span>
              <strong>5 min</strong>
            </div>
          </section>

          <section class="sideCard dailyGoalCard">
            <div class="sideCardHeading">
              <span class="sideIcon" aria-hidden="true">🎯</span>
              <div>
                <h3>Daily Study Goal</h3>
                <p>A little progress every day</p>
              </div>
            </div>

            <div class="goalNumbers">
              <strong id="todayStudyMinutes" class="focusSkeleton skeletonStatNumber"></strong>
              <span id="dailyGoalTarget" class="focusSkeleton skeletonGoalNumber"></span>
            </div>
            <div class="goalProgressTrack">
              <div class="goalProgressFill focusSkeleton skeletonGoalProgress" id="goalProgressFill"></div>
            </div>

            <p class="goalMessage" id="goalMessage">
              You've got this! Keep growing 🌿
            </p>

            <div class="goalSettings">
              <label for="goalHoursInput">Daily target</label>

              <div class="goalInputs">
                <select id="goalHoursInput">
                  <option value="0">0 hours</option>
                  <% for (let h = 1; h <= 24; h++) { %>
                  <option value="<%= h %>"><%= h %> hour<%= h === 1 ? "" : "s" %></option>
                  <% } %>
                </select>

                <select id="goalMinutesInput">
                  <option value="0">0 minutes</option>
                  <option value="15">15 minutes</option>
                  <option value="30">30 minutes</option>
                  <option value="45">45 minutes</option>
                </select>
              </div>

              <button type="button" id="saveDailyGoalBtn">Save goal</button>
              <p id="goalSettingsMessage" aria-live="polite"></p>
            </div>

          </section>

          <section class="sideCard ambienceCard">
            <div class="sideCardHeading">
              <span class="sideIcon" aria-hidden="true">♫</span>
              <div>
                <h3>Focus Ambience</h3>
                <p>Set the mood for studying</p>
              </div>
            </div>

            <div class="ambienceOptions">
              <button type="button" class="ambienceBtn active" aria-label="Turn ambience off">
                <span>🔇</span>
                <small>None</small>
              </button>
              <button type="button" class="ambienceBtn" aria-label="Play rain ambience">
                <span>🌧️</span>
                <small>Rain</small>
              </button>
              <button type="button" class="ambienceBtn" aria-label="Play soft piano ambience">
                <span>🎹</span>
                <small>Soft Piano</small>
              </button>
              <button type="button" class="ambienceBtn" aria-label="Play forest ambience">
                <span>🌳</span>
                <small>Forest</small>
              </button>
            </div>
          </section>


        </aside>
      </div>
    </main>
  </div>
<script src="/js/session.js" defer></script>
</body>

</html>