      <main class="studyWorkspace">
        <div class="focusLayout">
          <!-- Main timer area -->
          <section class="timerSection">
            <div class="timerHeader">
              <div>
                <h1 class="pageTitle">Focus Session</h1>
                <p class="subtitle">Stay focused, study better 🌱</p>
              </div>
              <span class="focusBadge">✦ Time to focus</span>
            </div>

            <div class="timerOverlayCard">
              <div class="timerTopRow">
                <span class="timerModeLabel">✿ FOCUS TIME</span>
                <span class="timerStatus">Ready when you are</span>
              </div>

              <div class="timerDisplay">
                <span id="hours">00</span>:<span id="minutes">00</span>:<span
                  id="seconds"
                  >00</span
                >
              </div>

              <div class="timerLabels">
                <span>Hours</span>
                <span>Minutes</span>
                <span>Seconds</span>
              </div>

              
              <div class="timerModeSelector">
                  <button type="button" class="modeBtn active" data-mode="free">
                    Free Study
                  </button>
                  <button type="button" class="modeBtn" data-mode="pomodoro">
                      Pomodoro
                  </button>
              </div>


              <div class="breakControls">
                <span id="timerMessage">Ready to focus?</span>
                <button type="button" id="startBreakBtn" class="modeBtn">
                  ☕ Start 5-min Break
                </button>
              </div>

              <div class="timerControls">
                <button id="startBtn" type="button" class="controlBtn">
                  <span class="btnIcon">▶</span> Start
                </button>
                <button id="pauseBtn" type="button" class="controlBtn">
                  <span class="btnIcon">❚❚</span> Pause
                </button>
                <button id="resetBtn" type="button" class="controlBtn">
                  <span class="btnIcon">↺</span> Reset
                </button>
                <button
                  id="stopBtn"
                  type="button"
                  class="controlBtn stop"
                >
                  <span class="btnIcon">■</span> Stop
                </button>
              </div>
            </div>

            <div class="lastSessionCard">
              <div class="lastSessionIcon">☕</div>
              <div>
                <span class="cardEyebrow">YOUR LAST SESSION</span>
                <h3 id="lastSessionTitle">No sessions yet</h3>
                <p id="lastSessionDetails">
                  Your first study session starts here 🌱
                </p>
              </div>
              <span class="lastSessionDecoration">♡</span>
            </div>

            <!-- Overview cards -->
            <div class="overviewGrid">
              <div class="overviewCard">
                <span class="overviewIcon">◷</span>
                <span class="cardEyebrow">TOTAL HOURS LOGGED</span>
                <h2><span id="totalHoursText">0</span> <small>hrs</small></h2>
              </div>

              <div class="overviewCard">
                <span class="overviewIcon">🔥</span>
                <span class="cardEyebrow">STUDY STREAK</span>
                <h2><span id="streakDays">0</span> <small>days</small></h2>
              </div>

              <div class="overviewCard">
                <span class="overviewIcon">🌱</span>
                <span class="cardEyebrow">DAILY GOAL</span>

                <h2>
                  <span id="dailyGoalOverview">2</span> <small>hours</small>
                </h2>
              </div>
            </div>
          </section>

          <!-- Right side panel -->
          <aside class="focusSidebar">
            <section class="sideCard pomodoroCard">
              <div class="sideCardHeading">
                <span class="sideIcon">⏱</span>
                <div>
                  <h3>Pomodoro Settings</h3>
                  <p>Find your rhythm</p>
                </div>
              </div>

              <div class="durationOptions">
                <button class="durationBtn active" data-duration="25">
                  <strong>25 min</strong>
                  <span>Classic</span>
                </button>

                <button class="durationBtn" data-duration="50">
                  <strong>50 min</strong>
                  <span>Extended</span>
                </button>

                <button class="durationBtn" data-duration="custom">
                  <strong>Custom</strong>
                  <span>Your pace</span>
                </button>
              </div>

              <div class="customDurationBox" id="customDurationBox" hidden>
                <label for="customDurationInput"
                  >Focus duration (minutes)</label
                >
                <input
                  type="number"
                  id="customDurationInput"
                  min="1"
                  max="180"
                  placeholder="Enter minutes (1–180)"
                />
                <button
                  type="button"
                  id="applyCustomDuration"
                  class="durationBtn"
                >
                  Apply
                </button>
              </div>

              <div class="breakInfo">
                <span>📖 Study session</span>
                <strong id="studyDurationText">25 min</strong>
              </div>
              <div class="breakInfo">
                <span>☕ Short break</span>
                <strong>5 min</strong>
              </div>
            </section>

            <section class="sideCard dailyGoalCard">
              <div class="sideCardHeading">
                <span class="sideIcon">🎯</span>
                <div>
                  <h3>Daily Study Goal</h3>
                  <p>A little progress every day</p>
                </div>
              </div>

              <div class="goalNumbers">
                <strong id="todayStudyMinutes">0 min</strong>
                <span id="dailyGoalTarget">of 120 min</span>
              </div>

              <div class="goalProgressTrack">
                <div class="goalProgressFill" id="goalProgressFill"></div>
              </div>

              <p class="goalMessage" id="goalMessage">
                You've got this! Keep growing 🌿
              </p>
              
<div class="goalSettings">
  <label for="goalHoursInput">Daily target</label>

  <div class="goalInputs">
    <select id="goalHoursInput">
      <option value="0">0 hours</option>
      <% for (let h = 1; h <= 24; h++) { %>
        <option value="<%= h %>"><%= h %> hour<%= h === 1 ? "" : "s" %></option>
      <% } %>
    </select>

    <select id="goalMinutesInput">
      <option value="0">0 minutes</option>
      <option value="15">15 minutes</option>
      <option value="30">30 minutes</option>
      <option value="45">45 minutes</option>
    </select>
  </div>

  <button type="button" id="saveDailyGoalBtn">Save goal</button>
  <p id="goalSettingsMessage" aria-live="polite"></p>
</div>

            </section>

            <section class="sideCard ambienceCard">
              <div class="sideCardHeading">
                <span class="sideIcon">♫</span>
                <div>
                  <h3>Focus Ambience</h3>
                  <p>Set the mood for studying</p>
                </div>
              </div>

              <div class="ambienceOptions">
                <button type="button" class="ambienceBtn active" aria-label="Turn ambience off">
                  <span>🔇</span>
                  <small>None</small>
                </button>
                <button type="button" class="ambienceBtn" aria-label="Play rain ambience">
                  <span>🌧️</span>
                  <small>Rain</small>
                </button>
                <button type="button" class="ambienceBtn" aria-label="Play lo-fi ambience">
                  <span>🎵</span>
                  <small>Lo-fi</small>
                </button>
                <button type="button" class="ambienceBtn" aria-label="Play forest ambience">
                  <span>🌳</span>
                  <small>Forest</small>
                </button>
              </div>
            </section>

            <div class="focusQuote">
              <span>“</span>
              <p>Small steps every day lead to big changes.</p>
              <span class="quoteHeart">♡</span>
            </div>
          </aside>
        </div>
      </main>
    </div>
  <script>
  
  document.getElementById("logoutBtn").addEventListener("click", async () => {
      try {
        const response = await fetch("/logout", {
          method: "DELETE",
        });

        if (!response.ok) {
          throw new Error("Could not log out. Please try again.");
        }

        window.location.href = "/";
      } catch (error) {
        showToast(error.message, true);
      }
    });
  const totalHoursText = document.querySelector("#totalHoursText");
  const hoursDisplay = document.querySelector("#hours");
  const minsDisplay = document.querySelector("#minutes");
  const secsDisplay = document.querySelector("#seconds");
  const timerMessage = document.querySelector("#timerMessage");
  const timerStatus = document.querySelector(".timerStatus");
  const modeButtons = document.querySelectorAll(".timerModeSelector .modeBtn");
  const durationButtons = document.querySelectorAll(".durationOptions .durationBtn[data-duration]");
  const customDurationBox = document.querySelector("#customDurationBox");
  const customDurationInput = document.querySelector("#customDurationInput");
  const saveGoalBtn = document.querySelector("#saveDailyGoalBtn");
  const goalHoursInput = document.querySelector("#goalHoursInput");
  const goalMinutesInput = document.querySelector("#goalMinutesInput");
  const goalSettingsMessage = document.querySelector("#goalSettingsMessage");
  const studyDurationText = document.querySelector("#studyDurationText");

  const MINUTE = 60 * 1000;
  const DEFAULT_FOCUS_DURATION = 25 * MINUTE;
  const BREAK_DURATION = 5 * MINUTE;
  const STATE_KEY = "lumiTimerState";

  let elapsedMs = 0;
  let startTime = null;
  let timerInterval = null;
  let isRunning = false;
  let isStopped = false;
  let currentMode = "free";
  let timerType = "study";
  let focusDuration = DEFAULT_FOCUS_DURATION;
  let remainingTime = focusDuration;
  let pomodoroCompleted = false;
  let sessionSaved = false;

  function showToast(text, duration = 2400) {
    Toastify({ text, duration, gravity: "top", position: "right" }).showToast();
  }

  function formatDuration(ms) {
    const totalSeconds = Math.max(0, Math.floor(ms / 1000));
    const h = Math.floor(totalSeconds / 3600);
    const m = Math.floor((totalSeconds % 3600) / 60);
    const s = totalSeconds % 60;
    return { h, m, s };
  }

  function renderCountUp() {
    const { h, m, s } = formatDuration(elapsedMs + (isRunning && startTime ? Date.now() - startTime : 0));
    hoursDisplay.textContent = String(h).padStart(2, "0");
    minsDisplay.textContent = String(m).padStart(2, "0");
    secsDisplay.textContent = String(s).padStart(2, "0");
  }

  function renderCountdown() {
    const ms = Math.max(0, remainingTime - (isRunning && startTime ? Date.now() - startTime : 0));
    const { h, m, s } = formatDuration(ms);
    hoursDisplay.textContent = String(h).padStart(2, "0");
    minsDisplay.textContent = String(m).padStart(2, "0");
    secsDisplay.textContent = String(s).padStart(2, "0");
  }

  function renderTimer() {
    if (currentMode === "pomodoro") renderCountdown();
    else renderCountUp();
    if (timerStatus) {
      timerStatus.textContent = isRunning
        ? (timerType === "break" ? "Break in progress" : "Focus session in progress")
        : (pomodoroCompleted && timerType === "study" ? "Session complete" : isStopped ? "Session stopped" : "Ready when you are");
    }
  }

  function persistTimerState() {
    const state = {
      elapsedMs, startTime, isRunning, isStopped, currentMode, timerType,
      focusDuration, remainingTime, pomodoroCompleted, sessionSaved
    };
    try { sessionStorage.setItem(STATE_KEY, JSON.stringify(state)); }
    catch (error) { console.error("Could not save timer state:", error); }
  }

  function stopInterval() {
    if (timerInterval) clearInterval(timerInterval);
    timerInterval = null;
  }

  async function saveStudySession(durationMs) {
    const duration = Math.floor(durationMs);
    if (duration < 1000) return false;
    try {
      const response = await fetch("/focusSession", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ duration, mode: currentMode })
      });
      const result = await response.json();
      if (!response.ok) throw new Error(result.message || "Failed to save study session.");
      await loadFocusStats();
      return true;
    } catch (error) {
      console.error("Could not save study session:", error);
      showToast("Could not save your study session. Please try again.");
      return false;
    }
  }

  async function completePomodoroStudy() {
    if (sessionSaved) return;
    sessionSaved = true;
    const saved = await saveStudySession(focusDuration);
    if (!saved) sessionSaved = false;
  }

  async function loadFocusStats() {
    try {
      const response = await fetch("/focusSession/total");
      const data = await response.json();
      if (!response.ok) throw new Error(data.message || "Failed to load study statistics.");

      const todayMs = Number(data.todayMilliseconds) || 0;
      const goalMinutes = Number(data.dailyGoalMinutes) || 120;
      const goalMs = goalMinutes * MINUTE;
      const todayMinutes = Math.floor(todayMs / MINUTE);
      totalHoursText.textContent = (todayMs / 3600000).toFixed(2);
      document.querySelector("#todayStudyMinutes").textContent = `${todayMinutes} min`;

      const goalHours = Math.floor(goalMinutes / 60);
      const goalRemainder = goalMinutes % 60;
      const goalParts = [];
      if (goalHours) goalParts.push(`${goalHours} hr`);
      if (goalRemainder) goalParts.push(`${goalRemainder} min`);
      document.querySelector("#dailyGoalTarget").textContent = `of ${goalParts.join(" ")}`;
      document.querySelector("#dailyGoalOverview").textContent =
        goalRemainder === 0 ? String(goalHours) : `${goalHours}:${String(goalRemainder).padStart(2, "0")}`;
      document.querySelector("#streakDays").textContent = data.streak ?? 0;
      document.querySelector("#goalProgressFill").style.width =
        `${Math.min(100, (todayMs / goalMs) * 100)}%`;
      document.querySelector("#goalMessage").textContent = data.goalMet
        ? "Daily goal completed! Amazing work 🌱"
        : "You've got this! Keep growing 🌿";

      
      goalHoursInput.value = String(Math.floor(goalMinutes / 60));
      goalMinutesInput.value = String(goalMinutes % 60);
      if (goalSettingsMessage && goalSettingsMessage.textContent === "Saving...") {
        goalSettingsMessage.textContent = "Daily goal saved successfully!";
      }

      const title = document.querySelector("#lastSessionTitle");
      const details = document.querySelector("#lastSessionDetails");
      if (data.lastSession) {
        const session = data.lastSession;
        const modeNames = { free: "Free Study", pomodoro: "Pomodoro", deep: "Deep Focus" };
        const mins = Math.round((Number(session.duration) || 0) / MINUTE);
        title.textContent = modeNames[session.mode] || "Study Session";
        details.textContent = `${mins} min · ${new Date(session.createdAt).toLocaleString()}`;
      } else {
        title.textContent = "No sessions yet";
        details.textContent = "Your first study session starts here 🌱";
      }
    } catch (error) {
      console.error("Could not load focus statistics:", error);
    }
  }

  saveGoalBtn.addEventListener("click", async () => {
    const hours = Number(goalHoursInput.value);
    const minutes = Number(goalMinutesInput.value);
    const totalMinutes = hours * 60 + minutes;

    if (!Number.isInteger(hours) || !Number.isInteger(minutes) ||
        totalMinutes < 1 || totalMinutes > 1440) {
      goalSettingsMessage.textContent = "Choose a goal between 1 minute and 24 hours.";
      return;
    }

    goalSettingsMessage.textContent = "Saving...";
    saveGoalBtn.disabled = true;
    try {
      const response = await fetch("/focusSession/goal", {
        method: "PATCH",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ hours, minutes })
      });
      const data = await response.json();
      if (!response.ok) throw new Error(data.message || "Could not save goal.");
      goalSettingsMessage.textContent = data.message;
      await loadFocusStats();
    } catch (error) {
      goalSettingsMessage.textContent = error.message;
    } finally {
      saveGoalBtn.disabled = false;
    }
  });

  goalHoursInput.addEventListener("change", () => {
    if (Number(goalHoursInput.value) === 24) goalMinutesInput.value = "0";
  });

  function updateStudyDurationLabel() {
    if (studyDurationText) studyDurationText.textContent = `${Math.round(focusDuration / MINUTE)} min`;
  }

  function resetSessionState() {
    elapsedMs = 0;
    remainingTime = focusDuration;
    timerType = "study";
    pomodoroCompleted = false;
    sessionSaved = false;
    isStopped = false;
    startTime = null;
  }

  function tick() {
    if (currentMode === "pomodoro") {
      const remaining = Math.max(0, remainingTime - (Date.now() - startTime));
      if (remaining <= 0) {
        remainingTime = 0;
        stopInterval();
        isRunning = false;
        startTime = null;
        if (timerType === "study") {
          pomodoroCompleted = true;
          timerMessage.textContent = "Pomodoro complete! Your session is being saved. Start your break when ready ☕";
          renderTimer();
          persistTimerState();
          completePomodoroStudy().then(() => {
            showToast("Pomodoro complete! Study time saved 🌱", 3000);
            persistTimerState();
          });
        } else {
          timerType = "study";
          remainingTime = focusDuration;
          elapsedMs = 0;
          pomodoroCompleted = false;
          sessionSaved = false;
          timerMessage.textContent = "Break complete! Ready for another Pomodoro? 🌱";
          renderTimer();
          persistTimerState();
          showToast("Break complete! 🌱");
        }
        return;
      }
    } else {
      elapsedMs += Date.now() - startTime;
      startTime = Date.now();
    }
    renderTimer();
    persistTimerState();
  }

  function startTimer() {
    if (isRunning) return;
    if (currentMode === "pomodoro" && timerType === "study" && pomodoroCompleted) {
      showToast("Take your break before starting another Pomodoro ☕");
      return;
    }
    if (isStopped) {
      resetSessionState();
    }
    isRunning = true;
    startTime = Date.now();
    stopInterval();
    timerInterval = setInterval(tick, 250);
    
timerMessage.textContent = timerType === "break"
  ? "Enjoy your 5-minute break ☕"
  : currentMode === "pomodoro"
    ? `Focus for ${Math.round(focusDuration / MINUTE)} minutes`
    : "You're in Free Study. Keep going at your own pace 🌱";

    renderTimer();
    persistTimerState();
  }

  function pauseTimer() {
    if (!isRunning) return;
    const delta = Math.max(0, Date.now() - startTime);
    if (currentMode === "pomodoro") remainingTime = Math.max(0, remainingTime - delta);
    else elapsedMs += delta;
    stopInterval();
    isRunning = false;
    startTime = null;
    renderTimer();
    persistTimerState();
  }

  function resetTimer() {
    stopInterval();
    isRunning = false;
    resetSessionState();
    
timerMessage.textContent = currentMode === "pomodoro"
  ? `Ready for a ${Math.round(focusDuration / MINUTE)}-minute session?`
  : "Ready to focus?";

    renderTimer();
    persistTimerState();
  }

  async function stopTimer() {
    if (timerType === "break" && currentMode === "pomodoro") {
      stopInterval();
      isRunning = false;
      isStopped = false;
      startTime = null;
      timerType = "study";
      remainingTime = focusDuration;
      elapsedMs = 0;
      pomodoroCompleted = false;
      sessionSaved = false;
      timerMessage.textContent = "Break ended. Ready for another Pomodoro? 🌱";
      renderTimer();
      persistTimerState();
      return;
    }
    if (isStopped) return;

    let durationMs;
    if (currentMode === "pomodoro") {
      const currentRemaining = isRunning ? Math.max(0, remainingTime - (Date.now() - startTime)) : remainingTime;
      durationMs = Math.max(0, focusDuration - currentRemaining);
      remainingTime = currentRemaining;
    } else {
      durationMs = elapsedMs + (isRunning && startTime ? Date.now() - startTime : 0);
      elapsedMs = durationMs;
    }

    stopInterval();
    isRunning = false;
    isStopped = true;
    startTime = null;
    renderTimer();
    persistTimerState();

    if (durationMs >= 1000 && !sessionSaved) {
      const saved = await saveStudySession(durationMs);
      if (saved) sessionSaved = true;
      persistTimerState();
    }
    timerMessage.textContent = durationMs >= 1000
      ? "Session stopped. Your study time has been logged 🌱"
      : "No study time to save yet.";
  }

  function startBreak() {
    if (currentMode !== "pomodoro" || isRunning || timerType !== "study" ||
        !pomodoroCompleted || remainingTime > 0) {
      showToast("Finish a Pomodoro session before starting your break.");
      return;
    }
    timerType = "break";
    remainingTime = BREAK_DURATION;
    elapsedMs = 0;
    isStopped = false;
    startTime = null;
    timerMessage.textContent = "Enjoy your 5-minute break ☕";
    renderTimer();
    persistTimerState();
    startTimer();
  }

  modeButtons.forEach((button) => {
    button.addEventListener("click", () => {
      if (isRunning) {
        showToast("Pause the timer before changing modes.");
        return;
      }
      stopInterval();
      currentMode = button.dataset.mode;
      modeButtons.forEach((btn) => btn.classList.toggle("active", btn === button));
      resetSessionState();
      
timerMessage.textContent = currentMode === "pomodoro"
  ? `Ready for a ${Math.round(focusDuration / MINUTE)}-minute session?`
  : "Ready to focus?";

      renderTimer();
      persistTimerState();
    });
  });

  durationButtons.forEach((button) => {
    button.addEventListener("click", () => {
      if (isRunning) { showToast("Pause the timer before changing duration."); return; }
      if (currentMode !== "pomodoro") {
        showToast("Select Pomodoro mode to change the focus duration.");
        return;
      }
      const value = button.dataset.duration;
      if (value === "custom") {
        customDurationBox.hidden = false;
        customDurationInput.focus();
        durationButtons.forEach((btn) => btn.classList.toggle("active", btn === button));
        return;
      }
      focusDuration = Number(value) * MINUTE;
      durationButtons.forEach((btn) => btn.classList.toggle("active", btn === button));
      customDurationBox.hidden = true;
      resetSessionState();
      updateStudyDurationLabel();
      timerMessage.textContent = `Ready for a ${value}-minute session?`;
      renderTimer();
      persistTimerState();
    });
  });

  document.querySelector("#applyCustomDuration").addEventListener("click", () => {
    if (isRunning) { showToast("Pause the timer before changing duration."); return; }
    if (currentMode !== "pomodoro") { showToast("Select Pomodoro mode to change the focus duration."); return; }
    const customMinutes = Number(customDurationInput.value);
    if (!Number.isInteger(customMinutes) || customMinutes < 1 || customMinutes > 180) {
      showToast("Enter a whole number between 1 and 180.");
      return;
    }
    focusDuration = customMinutes * MINUTE;
    durationButtons.forEach((btn) => btn.classList.toggle("active", btn.dataset.duration === "custom"));
    customDurationBox.hidden = true;
    resetSessionState();
    updateStudyDurationLabel();
    timerMessage.textContent = `Ready for a ${customMinutes}-minute session?`;
    renderTimer();
    persistTimerState();
  });

  document.querySelector("#startBreakBtn").addEventListener("click", startBreak);
  document.querySelector("#startBtn").addEventListener("click", startTimer);
  document.querySelector("#pauseBtn").addEventListener("click", pauseTimer);
  document.querySelector("#resetBtn").addEventListener("click", resetTimer);
  document.querySelector("#stopBtn").addEventListener("click", stopTimer);

  function restoreTimerState() {
    let state;
    try {
      const raw = sessionStorage.getItem(STATE_KEY);
      if (!raw) { renderTimer(); updateStudyDurationLabel(); return; }
      state = JSON.parse(raw);
    } catch (error) {
      console.error("Could not restore timer state:", error);
      renderTimer();
      return;
    }

    elapsedMs = Math.max(0, Number(state.elapsedMs) || 0);
    isStopped = Boolean(state.isStopped);
    currentMode = ["free", "pomodoro"].includes(state.currentMode)
  ? state.currentMode
  : "free";
    timerType = state.timerType === "break" ? "break" : "study";
    focusDuration = Math.min(180 * MINUTE, Math.max(MINUTE, Number(state.focusDuration) || DEFAULT_FOCUS_DURATION));
    remainingTime = Number.isFinite(Number(state.remainingTime)) ? Math.max(0, Number(state.remainingTime)) : focusDuration;
    pomodoroCompleted = Boolean(state.pomodoroCompleted);
    sessionSaved = Boolean(state.sessionSaved);
    modeButtons.forEach((btn) => btn.classList.toggle("active", btn.dataset.mode === currentMode));

    durationButtons.forEach((btn) => {
      const val = btn.dataset.duration;
      const selected = (val === "25" && focusDuration === 25 * MINUTE) ||
        (val === "50" && focusDuration === 50 * MINUTE) ||
        (val === "custom" && focusDuration !== 25 * MINUTE && focusDuration !== 50 * MINUTE);
      btn.classList.toggle("active", selected);
    });
    if (focusDuration !== 25 * MINUTE && focusDuration !== 50 * MINUTE) customDurationInput.value = String(Math.round(focusDuration / MINUTE));
    updateStudyDurationLabel();

    if (state.isRunning && state.startTime) {
      const delta = Math.max(0, Date.now() - Number(state.startTime));
      if (currentMode === "pomodoro") {
        remainingTime = Math.max(0, remainingTime - delta);
        if (remainingTime <= 0) {
          isRunning = false;
          startTime = null;
          if (timerType === "study") {
            remainingTime = 0;
            pomodoroCompleted = true;
            timerMessage.textContent = "Pomodoro complete! Your session is being saved. Start your break when ready ☕";
            renderTimer();
            completePomodoroStudy();
          } else {
            timerType = "study";
            remainingTime = focusDuration;
            pomodoroCompleted = false;
            timerMessage.textContent = "Break complete! Ready for another Pomodoro? 🌱";
          }
        } else {
          isRunning = false;
          startTime = null;
          startTimer();
          return;
        }
      } else {
        elapsedMs += delta;
        isRunning = false;
        startTime = null;
        startTimer();
        return;
      }
    } else {
      isRunning = false;
      startTime = null;
    }

    
timerMessage.textContent = currentMode === "pomodoro"
  ? timerType === "break"
    ? "Break paused. Resume when ready ☕"
    : pomodoroCompleted
      ? "Pomodoro complete! Start your break when ready ☕"
      : `Ready for a ${Math.round(focusDuration / MINUTE)}-minute session?`
  : "Ready to focus?";

    renderTimer();
    persistTimerState();
  }

  
  let audioContext = null;
  let ambienceNodes = [];
  let ambienceSource = null;

  function stopAmbience() {
    ambienceNodes.forEach((node) => {
      try { if (node.stop) node.stop(); } catch (_) {}
      try { node.disconnect(); } catch (_) {}
    });
    ambienceNodes = [];
    ambienceSource = null;
    if (audioContext && audioContext.state !== "closed") {
      audioContext.suspend().catch(() => {});
    }
  }

  function makeNoiseBuffer(ctx) {
    const buffer = ctx.createBuffer(1, ctx.sampleRate * 2, ctx.sampleRate);
    const output = buffer.getChannelData(0);
    for (let i = 0; i < output.length; i++) output[i] = Math.random() * 2 - 1;
    return buffer;
  }

  async function playAmbience(kind) {
    stopAmbience();
    if (kind === "none") return;
    const AudioContextClass = window.AudioContext || window.webkitAudioContext;
    if (!AudioContextClass) { showToast("Audio isn't supported by this browser."); return; }
    try {
      if (!audioContext || audioContext.state === "closed") audioContext = new AudioContextClass();
      await audioContext.resume();
      const master = audioContext.createGain();
      master.gain.value = 0.055;
      master.connect(audioContext.destination);
      ambienceNodes.push(master);

      if (kind === "rain" || kind === "forest") {
        const source = audioContext.createBufferSource();
        source.buffer = makeNoiseBuffer(audioContext);
        source.loop = true;
        const filter = audioContext.createBiquadFilter();
        filter.type = kind === "rain" ? "lowpass" : "bandpass";
        filter.frequency.value = kind === "rain" ? 1100 : 1900;
        filter.Q.value = kind === "rain" ? 0.5 : 0.8;
        const gain = audioContext.createGain();
        gain.gain.value = kind === "rain" ? 0.65 : 0.16;
        source.connect(filter);
        filter.connect(gain);
        gain.connect(master);
        source.start();
        ambienceNodes.push(source, filter, gain);
      } else if (kind === "lofi") {
        const osc1 = audioContext.createOscillator();
        const osc2 = audioContext.createOscillator();
        const filter = audioContext.createBiquadFilter();
        const gain = audioContext.createGain();
        osc1.type = "triangle";
        osc2.type = "sine";
        osc1.frequency.value = 174.61;
        osc2.frequency.value = 261.63;
        filter.type = "lowpass";
        filter.frequency.value = 650;
        gain.gain.value = 0.28;
        osc1.connect(filter);
        osc2.connect(filter);
        filter.connect(gain);
        gain.connect(master);
        osc1.start();
        osc2.start();
        ambienceNodes.push(osc1, osc2, filter, gain);
      }
      ambienceSource = kind;
    } catch (error) {
      console.error("Could not start ambience:", error);
      showToast("Couldn't start ambience. Try clicking the option again.");
    }
  }

  document.querySelectorAll(".ambienceBtn").forEach((button, index) => {
    const kinds = ["none", "rain", "lofi", "forest"];
    button.addEventListener("click", async () => {
      document.querySelectorAll(".ambienceBtn").forEach((btn) => btn.classList.toggle("active", btn === button));
      await playAmbience(kinds[index]);
    });
  });

 
  updateStudyDurationLabel();
  loadFocusStats();
  restoreTimerState();
</script>
  </body>
</html>